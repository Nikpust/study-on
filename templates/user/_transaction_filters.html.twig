<form
    id="transaction-filters-form"
    method="get"
    action="{{ path('app_user_transactions') }}"
    class="d-flex justify-content-end gap-2"
>
    <input
        type="search"
        name="filter[course_code]"
        value="{{ filters.course_code ?? '' }}"
        class="form-control w-25"
        placeholder="Введите код курса"
    >

    <div class="dropdown">
        <button
            class="btn btn-outline-secondary dropdown-toggle"
            type="button"
            data-bs-toggle="dropdown"
            aria-expanded="false"
        >
            Фильтры
        </button>

        <div class="dropdown-menu dropdown-menu-end p-3" style="width: 280px">
            <div class="form-check">
                <input
                    type="checkbox"
                    id="skip_expired"
                    name="filter[skip_expired]"
                    value="1"
                    class="form-check-input"
                    {% if filters.skip_expired ?? false %}checked{% endif %}
                >

                <label class="form-check-label" for="skip_expired">
                    Пропустить истёкшие аренды
                </label>
            </div>

            <hr class="dropdown-divider">

            <div class="form-check">
                <input
                    type="checkbox"
                    id="type_deposit"
                    name="filter[type][]"
                    value="deposit"
                    class="form-check-input"
                    {% if 'deposit' in filters.type|default([]) %}checked{% endif %}
                >

                <label class="form-check-label" for="type_deposit">
                    Пополнение
                </label>
            </div>

            <div class="form-check">
                <input
                    type="checkbox"
                    id="type_payment"
                    name="filter[type][]"
                    value="payment"
                    class="form-check-input"
                    {% if 'payment' in filters.type|default([]) %}checked{% endif %}
                >

                <label class="form-check-label" for="type_payment">
                    Покупка
                </label>
            </div>
        </div>
    </div>

    <button type="submit" class="btn btn-primary">
        Применить
    </button>

    <a href="{{ path('app_user_transactions') }}" class="btn btn-outline-secondary">
        Сбросить
    </a>
</form>
