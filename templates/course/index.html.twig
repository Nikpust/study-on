{% extends 'base.html.twig' %}

{% block title %}Курсы / StudyOn{% endblock %}

{% block body %}
    <div class="w-100 d-flex flex-row justify-content-between align-items-center">
        <div class="d-flex flex-column">
            <h1 class="mb-1 fw-bold">Курсы</h1>
            <p class="text-body-secondary mb-0">
                Выберите курс для обучения
            </p>
        </div>

        {% if app.user and is_granted('ROLE_SUPER_ADMIN') %}
            <div>
                <a href="{{ path('app_course_new') }}" class="btn btn-primary">
                    Создать новый курс
                </a>
            </div>
        {% endif %}
    </div>

    {% if courses is not empty %}
        <div class="row row-cols-4 g-4">
            {% for courseInfo in courses %}
                <div class="col">
                    <div class="card h-100 rounded-3">
                        <div class="card-body p-4 d-flex flex-column gap-3">
                            <div class="d-flex justify-content-between gap-3">
                                <h4 class="card-title fw-semibold mb-0">
                                    <a href="{{ path('app_course_show', {'id': courseInfo.course.id}) }}"
                                       class="text-dark text-decoration-none">
                                        {{ courseInfo.course.title }}
                                    </a>
                                </h4>

                                <div>
                                    {% if courseInfo.type == 'free' %}
                                        <span class="badge bg-success">
                                            Бесплатно
                                        </span>

                                    {% elseif courseInfo.payment %}
                                        {% if courseInfo.type == 'buy' %}
                                            <span class="badge bg-success">
                                                Куплен
                                            </span>
                                        {% elseif courseInfo.type == 'rent'
                                            and courseInfo.payment.expires_at is defined
                                            and courseInfo.payment.expires_at is not empty
                                        %}
                                            <span class="badge bg-success">
                                                Арендован
                                            </span>
                                        {% endif %}

                                    {% elseif courseInfo.type == 'buy' %}
                                        <span class="badge bg-primary">
                                            {{ courseInfo.price }} ₽
                                        </span>

                                    {% elseif courseInfo.type == 'rent' %}
                                        <span class="badge bg-warning text-dark">
                                            {{ courseInfo.price }} ₽ / нед.
                                        </span>
                                    {% endif %}
                                </div>
                            </div>

                            {% if courseInfo.course.description %}
                                <p class="card-text text-body-secondary mb-0">
                                    {{ courseInfo.course.description }}
                                </p>
                            {% else %}
                                <p class="card-text text-body-secondary mb-0">
                                    Описание отсутствует
                                </p>
                            {% endif %}

                            {% if courseInfo.payment
                                and courseInfo.type == 'rent'
                                and courseInfo.payment.expires_at is defined
                                and courseInfo.payment.expires_at is not empty
                            %}
                                <div class="small text-primary">
                                    Ваша аренда дейсвтует до
                                    <span class="fw-medium">
                                        {{ courseInfo.payment.expires_at|date('d.m.Y H:i', 'Europe/Moscow') }}
                                    </span>
                                </div>
                            {% endif %}

                            <div class="mt-auto pt-3 border-top">
                                <a href="{{ path('app_course_show', {'id': courseInfo.course.id}) }}"
                                   class="btn btn-outline-primary w-100">
                                    Подробнее
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="card rounded-3">
            <div class="card-body text-center py-5">
                <h4 class="fw-semibold">Сервис временно недоступен</h4>
                <p class="text-body-secondary mb-0">
                    Курсы не найдены
                </p>
            </div>
        </div>
    {% endif %}
{% endblock %}
